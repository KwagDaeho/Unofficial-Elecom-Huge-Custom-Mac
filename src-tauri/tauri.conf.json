{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elecom Huge Custom",
  "version": "1.0.9",
  "identifier": "com.kwagdaeho.elecom-huge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elecom Huge Custom",
        "width": 820,
        "height": 880,
        "minWidth": 780,
        "minHeight": 640,
        "resizable": true,
        "devtools": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
